# Copiar a .env y completar. Nunca subir .env al repositorio.

# Servidor
PORT=3000
# Al menos 32 caracteres. Generar con: openssl rand -hex 32
JWT_SECRET=
# Contraseña de los usuarios de prueba que crea npm run seed (solo desarrollo)
SEED_CONTRASENA=

# PostgreSQL - Hospital General
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=hospital_general
PG_USER=
PG_PASSWORD=

# MySQL - Clínica Odontológica
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=clinica_odontologica
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# MongoDB Atlas - Laboratorio Clínico
# Solo cambia PEGA_AQUI_TU_CLAVE por la contraseña de hospital_app (sin < > ni espacios)
MONGO_URI=mongodb+srv://hospital_app:PEGA_AQUI_TU_CLAVE@cluster0.dnytpvg.mongodb.net/?retryWrites=true&w=majority
MONGO_DATABASE=laboratorio_clinico
ESPERA_MOTOR_MS=8000

# Firebase - Centro Médico Pediátrico
FIREBASE_PROJECT_ID=
# Solo con el emulador: déjalo vacío si usas Firestore real
FIRESTORE_EMULATOR_HOST=localhost:8080
# Solo con un proyecto real: ruta al JSON de la cuenta de servicio (fuera del repositorio)
GOOGLE_APPLICATION_CREDENTIALS=
