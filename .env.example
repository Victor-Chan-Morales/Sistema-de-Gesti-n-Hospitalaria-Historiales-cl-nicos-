# Copiar a .env y completar. Nunca subir .env al repositorio.

# Servidor
PORT=3000
# Al menos 32 caracteres. Generar con: openssl rand -hex 32
JWT_SECRET=
# Contraseña de los usuarios de prueba que crea npm run seed (solo desarrollo)
SEED_CONTRASENA=

# PostgreSQL - Hospital General
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=hospital_general
PG_USER=
PG_PASSWORD=

# MySQL - Clínica Odontológica
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=clinica_odontologica
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# MongoDB - Laboratorio Clínico (replica set de un nodo, necesario para transacciones)
MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGO_DATABASE=laboratorio_clinico
# Opcional, en lugar de Docker local: MongoDB Atlas. Cambia TU_USUARIO, TU_CLAVE y TU_CLUSTER por los
# de tu clúster (Connect > Drivers). Con servicios en la nube sube también ESPERA_MOTOR_MS a 8000.
# MONGO_URI=mongodb+srv://TU_USUARIO:TU_CLAVE@TU_CLUSTER.mongodb.net/?retryWrites=true&w=majority

# Firebase - Centro Médico Pediátrico
FIREBASE_PROJECT_ID=
# Solo en desarrollo: apunta firebase-admin al emulador de Firestore
FIRESTORE_EMULATOR_HOST=localhost:8080
# Solo con un proyecto real: ruta al JSON de la cuenta de servicio (fuera del repositorio)
GOOGLE_APPLICATION_CREDENTIALS=

# Espera máxima (ms) para alcanzar MongoDB o Firestore. En local 2000; con servicios en la nube usa 8000.
ESPERA_MOTOR_MS=2000
