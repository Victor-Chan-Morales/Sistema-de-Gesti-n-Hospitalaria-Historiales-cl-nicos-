# Copiar a .env y completar. Nunca subir .env al repositorio.

# Servidor
PORT=3000
JWT_SECRET=

# PostgreSQL - Hospital General
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=hospital_general
PG_USER=
PG_PASSWORD=

# MySQL - Clínica Odontológica
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=clinica_odontologica
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# MongoDB - Laboratorio Clínico (replica set de un nodo, necesario para transacciones)
MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGO_DATABASE=laboratorio_clinico

# Firebase - Centro Médico Pediátrico
FIREBASE_PROJECT_ID=
# Solo en desarrollo: apunta firebase-admin al emulador de Firestore
FIRESTORE_EMULATOR_HOST=localhost:8080
# Solo con un proyecto real: ruta al JSON de la cuenta de servicio (fuera del repositorio)
GOOGLE_APPLICATION_CREDENTIALS=
